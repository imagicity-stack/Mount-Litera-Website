rules_version = '2';

// Firestore access policy for The Elden Heights School.
//
// The browser never talks to Firestore directly. Every read and write goes
// through a Next.js API route that authenticates the caller and then uses the
// Firebase Admin SDK — and the Admin SDK bypasses these rules entirely.
//
// So the correct policy for the client is: nothing. Denying everything here
// costs the application no functionality and removes the whole surface of
// "someone signed in and queried the database from the console".
//
// If a future feature genuinely needs direct client reads, add a narrow
// allow-read rule for that one collection rather than loosening the default.

service cloud.firestore {
  match /databases/{database}/documents {

    // Collections in use — all served by API routes:
    //   blogs      → /api/blogs, /api/blogs/[id]
    //   popups     → /api/popups, /api/popups/[id], /api/popups/track
    //   siteMedia  → /api/media, /api/media/[slot]
    //   users      → /api/admin/verify, /api/admin/password-changed
    //                  (the `role: "admin"` field that grants portal access is
    //                   created by hand in the console, which bypasses rules)
    //   admissions → /api/admissions/submit
    //
    // The Parent Room collections are the reason this default matters most.
    // They hold parents' contact details, what a parent has said about their
    // child, and counsellors' private notes about a minor. Nothing in the
    // browser reads or writes them:
    //
    //   parent_room_bookings  → /api/parent-room/hold, /confirm,
    //                             /booking/[id] (narrow view, token-gated),
    //                             /api/admin/parent-room/* (admin only)
    //   parent_room_slots     → /api/parent-room/availability (times only,
    //                             never who booked them),
    //                             /api/admin/parent-room/slots
    //   parent_room_settings  → /api/parent-room/availability (public subset),
    //                             /api/admin/parent-room/settings
    //
    // A signed-in parent has no more access to these than a stranger does,
    // which is correct: authentication in this application confers admin
    // access and nothing else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
